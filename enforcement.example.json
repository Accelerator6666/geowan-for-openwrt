{
  "enabled": true,
  "mode": "observe",
  "ban_seconds": 604800,
  "max_bans": 65536,
  "log_rate_per_second": 2,
  "log_burst": 10,
  "honeypot_ports": [
    { "port": 21, "proto": "tcp", "family": "any", "label": "FTP probe" },
    { "port": 23, "proto": "tcp", "family": "any", "label": "Telnet probe" },
    { "port": 445, "proto": "tcp", "family": "any", "label": "SMB probe" }
  ],
  "exception_ports": [
    { "port": 31080, "proto": "tcp", "family": "any", "label": "JumpServer" },
    { "port": 31080, "proto": "udp", "family": "any", "label": "JumpServer" },
    { "port": 58964, "proto": "tcp", "family": "any", "label": "RDP" },
    { "port": 58964, "proto": "udp", "family": "any", "label": "RDP" },
    { "port": 20443, "proto": "tcp", "family": "any", "label": "SSL VPN" },
    { "port": 20443, "proto": "udp", "family": "any", "label": "SSL VPN" }
  ]
}
